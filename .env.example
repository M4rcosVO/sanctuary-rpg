# ==============================================================================
# SANCTUARY RPG — Variáveis de Ambiente
# ==============================================================================
# Copie este ficheiro para .env (desenvolvimento local) ou adicione as variáveis
# diretamente no painel da Vercel (Project Settings > Environment Variables).
#
# NÃO adicione credenciais reais a este ficheiro ou ao repositório público!
# ==============================================================================

# SUPABASE — Configuração do Banco de Dados em Nuvem (PostgreSQL)
# Obtenha em: https://supabase.com/dashboard > Seu Projeto > Project Settings > API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_publica_aqui
